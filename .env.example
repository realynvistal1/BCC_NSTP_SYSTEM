PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bcc_nstp_database
JWT_SECRET=replace-with-a-long-random-secret
GMAIL_USER=
GMAIL_APP_PASSWORD=
COOKIE_SECURE=true
TRUST_PROXY_HOPS=1
# Set this to your Render web service URL after first deploy, for example:
# GOOGLE_RECAPTCHA_EXPECTED_HOSTNAME=my-app.onrender.com
GOOGLE_RECAPTCHA_ENABLED=true
GOOGLE_RECAPTCHA_SITE_KEY=
GOOGLE_RECAPTCHA_SECRET_KEY=
GOOGLE_RECAPTCHA_MIN_SCORE=0.5
GOOGLE_RECAPTCHA_EXPECTED_HOSTNAME=your-domain.com
GOOGLE_RECAPTCHA_ALLOW_LOCALHOST_BYPASS=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_BLOCK_MS=300000
RATE_LIMIT_MAX_BLOCK_MS=3600000
RATE_LIMIT_MAX_CONCURRENT=30
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_REQUESTS=20
AUTH_RATE_LIMIT_BLOCK_MS=600000
AUTH_RATE_LIMIT_MAX_BLOCK_MS=7200000
AUTH_RATE_LIMIT_MAX_CONCURRENT=5
