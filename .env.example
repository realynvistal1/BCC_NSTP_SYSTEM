PORT=3000
DB_HOST=localhost
DB_PORT=3306
# On Windows, start an existing local XAMPP database when the app starts.
# Set false to manage MySQL yourself. Disabled in NODE_ENV=production.
DB_AUTO_START=true
# XAMPP_PATH=C:\xampp
DB_USER=root
DB_PASSWORD=
DB_NAME=bcc_nstp_database
JWT_SECRET=replace-with-a-long-random-secret
GMAIL_USER=
# Actual public HTTPS origin of this deployment (no path). Required for instructor invitation links.
PUBLIC_APP_URL=
GMAIL_APP_PASSWORD=
COOKIE_SECURE=true
TRUST_PROXY_HOPS=1
# Set this to your Render web service URL after first deploy, for example:
# GOOGLE_RECAPTCHA_EXPECTED_HOSTNAME=my-app.onrender.com
GOOGLE_RECAPTCHA_ENABLED=true
GOOGLE_RECAPTCHA_SITE_KEY=
GOOGLE_RECAPTCHA_SECRET_KEY=
GOOGLE_RECAPTCHA_MIN_SCORE=0.5
GOOGLE_RECAPTCHA_EXPECTED_HOSTNAME=your-domain.com
GOOGLE_RECAPTCHA_ALLOW_LOCALHOST_BYPASS=false
# Shared reCAPTCHA v2 Checkbox keys for all logins and student enrollment.
# The ROTC_V2 variable names are retained for existing configurations.
# Register localhost and your deployed domain in Google's key settings.
GOOGLE_RECAPTCHA_ROTC_V2_ENABLED=false
GOOGLE_RECAPTCHA_ROTC_V2_SITE_KEY=
GOOGLE_RECAPTCHA_ROTC_V2_SECRET_KEY=
RATE_LIMIT_WINDOW_MS=10000
RATE_LIMIT_MAX_REQUESTS=200
RATE_LIMIT_MAX_CONCURRENT=30
# Total in-flight API requests across all IPs, per app process.
RATE_LIMIT_MAX_TOTAL_CONCURRENT=30
AUTH_RATE_LIMIT_WINDOW_MS=10000
AUTH_RATE_LIMIT_MAX_REQUESTS=50
AUTH_RATE_LIMIT_MAX_CONCURRENT=20
# Total in-flight authentication requests across all IPs, per app process.
AUTH_RATE_LIMIT_MAX_TOTAL_CONCURRENT=20
